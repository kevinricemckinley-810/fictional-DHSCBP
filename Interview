import os
import httpx
from fastapi import Depends, FastAPI, Header, HTTPException

from common.auth import parse_identity

app = FastAPI(title="Fictional CBP Traveler Gateway")

TRAVELER_SERVICE_URL = os.getenv("TRAVELER_SERVICE_URL", "http://127.0.0.1:8001")
INSPECTION_SERVICE_URL = os.getenv("INSPECTION_SERVICE_URL", "http://127.0.0.1:8002")
INTERNAL_API_KEY = os.getenv("INTERNAL_API_KEY", "demo-internal-key")

def downstream_headers(identity: dict, x_user_role: str | None) -> dict:
    effective_role = x_user_role or identity["role"]
    return {
        "X-User-Id": identity["user_id"],
        "X-User-Role": effective_role,
        "X-User-Office": identity["office"],
        "X-Internal-Key": INTERNAL_API_KEY,
    }

@app.get("/api/travelers/{traveler_id}")
async def get_traveler(
    traveler_id: str,
    identity: dict = Depends(parse_identity),
    x_user_role: str | None = Header(default=None),
):
    async with httpx.AsyncClient() as client:
        response = await client.get(
            f"{TRAVELER_SERVICE_URL}/internal/travelers/{traveler_id}",
            headers=downstream_headers(identity, x_user_role),
        )
    if response.status_code >= 400:
        raise HTTPException(status_code=response.status_code, detail=response.text)
    return response.json()

@app.post("/api/travelers/{traveler_id}/risk")
async def update_risk(
    traveler_id: str,
    payload: dict,
    identity: dict = Depends(parse_identity),
    x_user_role: str | None = Header(default=None),
):
    async with httpx.AsyncClient() as client:
        response = await client.post(
            f"{TRAVELER_SERVICE_URL}/internal/travelers/{traveler_id}/risk",
            json=payload,
            headers=downstream_headers(identity, x_user_role),
        )
    if response.status_code >= 400:
        raise HTTPException(status_code=response.status_code, detail=response.text)
    return response.json()

@app.post("/api/cases/{case_id}/release")
async def release_case(
    case_id: str,
    identity: dict = Depends(parse_identity),
    x_user_role: str | None = Header(default=None),
):
    async with httpx.AsyncClient() as client:
        response = await client.post(
            f"{INSPECTION_SERVICE_URL}/internal/cases/{case_id}/release",
            headers=downstream_headers(identity, x_user_role),
        )
    if response.status_code >= 400:
        raise HTTPException(status_code=response.status_code, detail=response.text)
    return response.json()
from fastapi import FastAPI, Header, HTTPException

app = FastAPI(title="Fictional CBP Traveler Service")
EXPECTED_INTERNAL_KEY = "demo-internal-key"

TRAVELERS = {
    "T-1001": {
        "traveler_id": "T-1001",
        "name": "Alex Morgan",
        "dob": "1988-04-12",
        "passport": "X0001001",
        "assigned_office": "JFK",
        "risk_score": 87,
        "watchlist_note": "Synthetic training flag: secondary review required.",
    },
    "T-1002": {
        "traveler_id": "T-1002",
        "name": "Jordan Lee",
        "dob": "1991-09-30",
        "passport": "X0001002",
        "assigned_office": "IAD",
        "risk_score": 21,
        "watchlist_note": "",
    },
}

def require_internal_key(x_internal_key: str | None):
    if x_internal_key != EXPECTED_INTERNAL_KEY:
        raise HTTPException(status_code=403, detail="invalid internal key")

@app.get("/internal/travelers/{traveler_id}")
def get_traveler(
    traveler_id: str,
    x_user_id: str | None = Header(default=None),
    x_user_role: str | None = Header(default=None),
    x_user_office: str | None = Header(default=None),
    x_internal_key: str | None = Header(default=None),
):
    require_internal_key(x_internal_key)
    traveler = TRAVELERS.get(traveler_id)
    if not traveler:
        raise HTTPException(status_code=404, detail="traveler not found")

    if x_user_role not in {"officer", "supervisor", "analyst"}:
        raise HTTPException(status_code=403, detail="role not permitted")

    if x_user_role == "officer" and x_user_office != traveler["assigned_office"]:
        raise HTTPException(status_code=403, detail="record outside assigned office")

    return traveler

@app.post("/internal/travelers/{traveler_id}/risk")
def update_risk(
    traveler_id: str,
    payload: dict,
    x_user_id: str | None = Header(default=None),
    x_user_role: str | None = Header(default=None),
    x_internal_key: str | None = Header(default=None),
):
    require_internal_key(x_internal_key)
    traveler = TRAVELERS.get(traveler_id)
    if not traveler:
        raise HTTPException(status_code=404, detail="traveler not found")

    if x_user_role not in {"analyst", "supervisor"}:
        raise HTTPException(status_code=403, detail="insufficient role")

    new_score = payload.get("risk_score")
    if not isinstance(new_score, int) or not 0 <= new_score <= 100:
        raise HTTPException(status_code=400, detail="risk_score must be 0-100")

    traveler["risk_score"] = new_score
    return {
        "traveler_id": traveler_id,
        "risk_score": new_score,
        "updated_by": x_user_id,
    }
